          "required": [],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {}
            },
            "required": ["statusCode", "response"],
            "additionalProperties": false
          }
        },
        "list": {
          "$id": "api/controller/data/list",
          "route": "/list",
          "methods": ["GET"],
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {}
            },
            "required": ["statusCode", "response"],
            "additionalProperties": false
          }
        },
        "details": {
          "$id": "api/controller/data/details",
          "route": "/details",
          "methods": ["GET"],
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            }
          },
          "required": ["id"],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {}
            },
            "required": ["statusCode", "response"],
            "additionalProperties": false
          }
        }
      },
      "colormaps": {
        "$id": "api/controller/colormaps",
        "route": "/colormaps",
        "methods": ["GET"],
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false,
        "response": {
          "type": "object",
          "properties": {
            "statusCode": {
              "type": "integer"
            },
            "response": {
              "type": "object",
              "properties": {
                "categories": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "required": ["categories"],
              "additionalProperties": false
            }
          },
          "required": ["statusCode", "response"],
          "additionalProperties": false
        }
      },
      "style": {
        "set": {
          "$id": "api/controller/style/set",
          "route": "/set",
          "methods": ["POST"],
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 32,
              "maxLength": 32
            },
            "target": {
              "type": "string",
              "enum": [
                "points",
                "edges",
                "cells",
                "polygons",
                "polyhedra",
                "corners",
                "lines",
                "surfaces",
                "blocks"
              ]
            },
            "componentIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "visibility": {
              "type": "boolean"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
            },
            "size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "coloring": {
              "type": "string",
              "enum": ["constant", "random", "textures"]
            }
          },
          "required": ["id"],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {}
            },
            "required": ["statusCode", "response"],
            "additionalProperties": false
          }
        }
      },
      "viewer": {
        "mesh": {
          "points": {
            "visibility": {
              "$id": "api/controller/viewer/mesh/points/visibility",
              "route": "/visibility",
              "methods": ["POST"],
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32
                },
                "visibility": {
                  "type": ["boolean", "string", "number"]
                }
              },
              "required": ["id", "visibility"],
              "additionalProperties": false,
              "response": {
                "type": "object",
                "properties": {
                  "statusCode": {
                    "type": "integer"
                  },
                  "response": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "visibility": {
                        "type": "boolean"
                      }
                    },
                    "required": ["id", "visibility"],
                    "additionalProperties": false
                  }
                },
                "required": ["statusCode", "response"],
                "additionalProperties": false
              }
            }
          }
        },
        "state": {
          "$id": "api/controller/viewer/state",
          "route": "/state",
          "methods": ["GET"],
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {}
