    "llm": {
      "status": {
        "$id": "api/llm/status",
        "route": "/status",
        "methods": ["GET"],
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false,
        "response": {
          "type": "object",
          "properties": {
            "statusCode": {
              "type": "integer"
            },
            "running": {
              "type": "boolean"
            }
          },
          "required": ["statusCode", "running"],
          "additionalProperties": false
        }
      },
      "run": {
        "$id": "api/llm/run",
        "route": "/run",
        "methods": ["POST"],
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false,
        "response": {
          "type": "object",
          "properties": {
            "statusCode": {
              "type": "integer"
            },
            "port": {
              "type": "integer"
            },
            "apiKey": {
              "type": "string"
            }
          },
          "required": ["statusCode", "port", "apiKey"],
          "additionalProperties": false
        }
      },
      "kill": {
        "$id": "api/llm/kill",
        "route": "/kill",
        "methods": ["POST"],
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false,
        "response": {
          "type": "object",
          "properties": {
            "statusCode": {
              "type": "integer"
            }
          },
          "required": ["statusCode"],
          "additionalProperties": false
        }
      },
      "chat": {
        "$id": "api/llm/chat",
        "route": "/chat",
        "methods": ["POST"],
        "type": "object",
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "minItems": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "gatewayApiKey": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["messages"],
        "additionalProperties": true,
        "response": {
          "format": "binary"
        }
      }
