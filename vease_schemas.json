              "type": "string",
              "minLength": 1
            },
            "location": {
              "type": "string",
              "enum": ["vertex", "edge", "cell", "polygon", "polyhedron", "point"]
            },
            "item": {
              "type": "integer",
              "minimum": 0
            },
            "minimum": {
              "type": "number"
            },
            "maximum": {
              "type": "number"
