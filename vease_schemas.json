            "additionalProperties": false
          }
        },
        "render": {
          "$id": "api/controller/viewer/render",
          "route": "/render",
          "methods": ["POST"],
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false,
          "response": {
            "type": "object",
            "properties": {
              "statusCode": {
                "type": "integer"
              },
              "response": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
