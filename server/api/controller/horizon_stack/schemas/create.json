{
  "route": "/create",
  "methods": ["POST"],
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "horizons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "unit_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["name", "horizons"],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "statusCode": {
        "type": "integer"
      },
      "response": {}
    },
    "required": ["statusCode", "response"],
    "additionalProperties": false
  }
}
