{
  "route": "/apply",
  "methods": ["POST"],
  "type": "object",
  "properties": {
    "filter": {
      "type": "string",
      "enum": ["shrink", "explode", "slice", "clip", "threshold"]
    },
    "ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 32, "maxLength": 32 },
      "minItems": 1
    },
    "remove": {
      "type": "boolean"
    },
    "factor": {
      "type": "number",
      "minimum": 0
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": { "type": "integer", "enum": [0, 1, 2] },
          "index": { "type": "integer", "minimum": 0 }
        },
        "required": ["axis", "index"],
        "additionalProperties": false
      }
    },
    "planes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "normal": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": ["origin", "normal"],
        "additionalProperties": false
      }
    },
    "attribute": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string",
      "enum": ["vertex", "edge", "cell", "polygon", "polyhedron", "point"]
    },
    "item": {
      "type": "integer",
      "minimum": 0
    },
    "minimum": {
      "type": "number"
    },
    "maximum": {
      "type": "number"
    }
  },
  "required": ["filter", "ids"],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "statusCode": {
        "type": "integer"
      },
      "response": {}
    },
    "required": ["statusCode", "response"],
    "additionalProperties": false
  }
}
